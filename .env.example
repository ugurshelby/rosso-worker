# Rosso worker ortam değişkenleri (server-side — service role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify katalog/token boru hattı (Saf Spotify)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm tür zenginleştirme — LAST_FM_API_KEY (.env.local standardı) ya da
# LASTFM_API_KEY kabul edilir.
LAST_FM_API_KEY=

# Token şifreleme (Spotify refresh token saklama)
TOKEN_ENCRYPTION_KEY=

# /yt/* endpoint'lerini koruyan paylaşılan gizli anahtar — Next.js ile AYNI
# değer olmalı (Vercel WORKER_SHARED_SECRET ile eşleşmeli). Boşsa dev'de kontrol
# atlanır; production'da MUTLAKA tanımlı olmalı.
WORKER_SHARED_SECRET=
